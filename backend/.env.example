# Copy this file to backend/.env and fill in your values.
# Both the API server (main.py) and generate_embeddings.py read these.

# --- Pinecone (required for /api/fact-check and the embedding upload) ---
PINECONE_API_KEY=pcsk_your_pinecone_key_here
PINECONE_INDEX_NAME=fact-check-claims
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=claims

# --- LLM: Groq (required for /api/fact-check) ---
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile


# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024

# --- Retrieval ---
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.82

# --- App ---
LOG_LEVEL=INFO
APP_VERSION=2.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Web search (Tier 2/3 live evidence) ---
# GOOGLE_API_KEY enables the Google Fact Check Tools API (real ClaimReview data).
# Without it, only the keyless DuckDuckGo fallback is used.
GOOGLE_API_KEY=
ENABLE_WEB_SEARCH=true

# --- Tier routing thresholds ---
HIGH_CONF_THRESHOLD=0.88
MEDIUM_CONF_THRESHOLD=0.86

# --- Supabase (admin password reset — service-role key, NEVER expose to frontend) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
