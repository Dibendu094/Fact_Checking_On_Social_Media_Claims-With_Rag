# Copy to frontend/.env and fill in.

# Supabase project URL and publishable ("anon") key. The anon key is designed to
# ship in the browser — row-level security on the `checks` table is what enforces
# that a user can only read/write their own rows. Never put the service-role key
# or the Postgres connection string here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Optional. Empty in dev (vite proxies /api -> :8000). Set to the backend origin
# in production.
VITE_API_URL=
